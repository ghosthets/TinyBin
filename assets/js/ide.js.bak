        'web_server': {
            name: 'ESP32 Web Server',
            description: 'HTTP web server with REST API',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <WiFi.h>\n#include <WebServer.h>\n\nconst char* ssid = "YOUR_SSID";\nconst char* password = "YOUR_PASSWORD";\n\nWebServer server(80);\n\nint ledState = 0;\nunsigned long uptime = 0;\n\nconst char* htmlPage = R"rawliteral(\n<!DOCTYPE html>\n<html>\n<head><title>TinyBin Server</title>\n<style>\nbody { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }\nh1 { color: #333; }\n.btn { padding: 10px 20px; font-size: 16px; cursor: pointer; border: none; border-radius: 5px; }\n.btn-on { background: #4CAF50; color: white; }\n.btn-off { background: #f44336; color: white; }\n.status { margin: 20px 0; padding: 15px; background: #f5f5f5; border-radius: 5px; }\n</style>\n</head>\n<body>\n<h1>TinyBin Web Server</h1>\n<div class="status">\n<p>LED State: <strong id="ledState">OFF</strong></p>\n<p>Uptime: <span id="uptime">0</span> seconds</p>\n</div>\n<button class="btn btn-on" onclick="fetch(\'/on\')">Turn ON</button>\n<button class="btn btn-off" onclick="fetch(\'/off\')">Turn OFF</button>\n<script>\nsetInterval(() => {\n    fetch(\'/status\').then(r => r.json()).then(d => {\n        document.getElementById(\'ledState\').textContent = d.led ? \'ON\' : \'OFF\';\n        document.getElementById(\'uptime\').textContent = d.uptime;\n    });\n}, 1000);\n</script>\n</body>\n</html>\n)rawliteral";\n\nvoid handleRoot() { server.send(200, "text/html", htmlPage); }\nvoid handleOn() { ledState = 1; digitalWrite(LED_BUILTIN, HIGH); server.send(200, "text/plain", "LED ON"); }\nvoid handleOff() { ledState = 0; digitalWrite(LED_BUILTIN, LOW); server.send(200, "text/plain", "LED OFF"); }\nvoid handleStatus() {\n    String json = "{\\"led\\":" + String(ledState) + ",\\"uptime\\":" + String(millis()/1000) + "}";\n    server.send(200, "application/json", json);\n}\nvoid handleNotFound() { server.send(404, "text/plain", "Not Found"); }\n\nvoid setup() {\n    Serial.begin(115200);\n    pinMode(LED_BUILTIN, OUTPUT);\n    WiFi.begin(ssid, password);\n    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }\n    Serial.println("\\nIP: " + WiFi.localIP().toString());\n    server.on("/", handleRoot);\n    server.on("/on", handleOn);\n    server.on("/off", handleOff);\n    server.on("/status", handleStatus);\n    server.onNotFound(handleNotFound);\n    server.begin();\n    Serial.println("Server started");\n}\n\nvoid loop() { server.handleClient(); }\n', type: 'cpp' },
