        'mqtt_client': {
            name: 'MQTT Client',
            description: 'Publish/subscribe via MQTT broker',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <WiFi.h>\n#include <PubSubClient.h>\n\nconst char* ssid = "YOUR_SSID";\nconst char* password = "YOUR_PASSWORD";\nconst char* mqttServer = "broker.hivemq.com";\nconst int mqttPort = 1883;\n\nWiFiClient espClient;\nPubSubClient client(espClient);\n\n#define LED_PIN LED_BUILTIN\n#define TEMP_PIN 34\n#define PUB_INTERVAL 10000\n\nunsigned long lastPub = 0;\n\nvoid callback(char* topic, byte* payload, unsigned int length) {\n    Serial.print("Message [");\n    Serial.print(topic);\n    Serial.print("] ");\n    String msg = "";\n    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];\n    Serial.println(msg);\n    if (msg == "on") { digitalWrite(LED_PIN, HIGH); client.publish("tinybin/led", "ON"); }\n    else if (msg == "off") { digitalWrite(LED_PIN, LOW); client.publish("tinybin/led", "OFF"); }\n}\n\nvoid reconnect() {\n    while (!client.connected()) {\n        String clientId = "ESP32-" + String(random(0xffff), HEX);\n        if (client.connect(clientId.c_str(), "tinybin/status", "offline")) {\n            client.publish("tinybin/status", "online");\n            client.subscribe("tinybin/cmd");\n            Serial.println("MQTT connected");\n        } else { delay(5000); }\n    }\n}\n\nvoid setup() {\n    Serial.begin(115200);\n    pinMode(LED_PIN, OUTPUT);\n    WiFi.begin(ssid, password);\n    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }\n    Serial.println("\\nIP: " + WiFi.localIP().toString());\n    client.setServer(mqttServer, mqttPort);\n    client.setCallback(callback);\n}\n\nvoid loop() {\n    if (!client.connected()) reconnect();\n    client.loop();\n    if (millis() - lastPub > PUB_INTERVAL) {\n        lastPub = millis();\n        float temp = analogRead(TEMP_PIN) / 4095.0 * 3.3 * 100;\n        client.publish("tinybin/temp", String(temp, 2).c_str());\n    }\n}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# MQTT Client\n\nproject_name: mqtt_client\nversion: 1.0.0\nboard: esp32\nbinary_path: build/mqtt_client.bin\n\nlibraries:\n  - name: WiFi\n    version: 2.0.0\n  - name: MQTT\n    version: 2.0.0\n\nbuild:\n  optimization: -Os\n  debug: false\n', type: 'tbin' }
