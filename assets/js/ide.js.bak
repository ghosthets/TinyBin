            description: 'PWM servo motor control with potentiometer',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <ESP32Servo.h>\n\n#define SERVO_PIN 18\n#define POT_PIN 34\n#define LED_PIN LED_BUILTIN\n\nServo myServo;\nint currentAngle = 0;\nint lastAngle = -1;\n\nvoid setup() {\n    Serial.begin(115200);\n    myServo.setPeriodHertz(50);\n    myServo.attach(SERVO_PIN, 500, 2400);\n    pinMode(LED_PIN, OUTPUT);\n    Serial.println("Servo Control Ready");\n}\n\nvoid loop() {\n    int potValue = analogRead(POT_PIN);\n    currentAngle = map(potValue, 0, 4095, 0, 180);\n    currentAngle = constrain(currentAngle, 0, 180);\n    if (currentAngle != lastAngle) {\n        myServo.write(currentAngle);\n        Serial.println("Angle: " + String(currentAngle) + "°");\n        lastAngle = currentAngle;\n        digitalWrite(LED_PIN, HIGH);\n        delay(50);\n        digitalWrite(LED_PIN, LOW);\n    }\n    delay(20);\n}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# Servo Motor Control\n\nproject_name: servo_control\nversion: 1.0.0\nboard: esp32\nbinary_path: build/servo_control.bin\n\nbuild:\n  optimization: -Os\n  debug: false\n', type: 'tbin' }
            ]
        },
        'neopixel': {
            name: 'NeoPixel Effects',
            description: 'WS2812B LED strip with animations',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <Adafruit_NeoPixel.h>\n\n#define PIN 4\n#define NUMPIXELS 16\n#define BRIGHTNESS 50\n\nAdafruit_NeoPixel pixels(NUMPIXELS, PIN, NEO_GRB + NEO_KHZ800);\n\nvoid rainbow(int wait) {\n    for (long firstPixelHue = 0; firstPixelHue < 5 * 65536; firstPixelHue += 256) {\n        for (int i = 0; i < pixels.numPixels(); i++) {\n            int pixelHue = firstPixelHue + (i * 65536L / pixels.numPixels());\n            pixels.setPixelColor(i, pixels.gamma32(pixels.ColorHSV(pixelHue)));\n        }\n        pixels.show();\n        delay(wait);\n    }\n}\n\nvoid theaterChase(uint32_t color, int wait) {\n    for (int a = 0; a < 10; a++) {\n        for (int b = 0; b < 3; b++) {\n            pixels.clear();\n            for (int c = b; c < pixels.numPixels(); c += 3) {\n                pixels.setPixelColor(c, color);\n            }\n            pixels.show();\n            delay(wait);\n        }\n    }\n}\n\nvoid setup() {\n    Serial.begin(115200);\n    pixels.begin();\n    pixels.setBrightness(BRIGHTNESS);\n    pixels.clear();\n    Serial.println("NeoPixel Ready");\n}\n\nvoid loop() {\n    theaterChase(pixels.Color(255, 0, 0), 50);\n    theaterChase(pixels.Color(0, 0, 255), 50);\n    rainbow(10);\n}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# NeoPixel Effects\n\nproject_name: neopixel\nversion: 1.0.0\nboard: esp32\nbinary_path: build/neopixel.bin\n\nlibraries:\n  - name: Adafruit_Sensor\n    version: 1.1.4\n\nbuild:\n  optimization: -Os\n  debug: false\n', type: 'tbin' }
            ]
        },
        'data_logger': {
            name: 'SD Card Data Logger',
            description: 'Log sensor data to SD card',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include "FS.h"\n#include "SD.h"\n#include "SPI.h"\n\n#define SD_CS 5\n#define LOG_INTERVAL 5000\n#define SENSOR_PIN 34\n\nunsigned long lastLog = 0;\n\nvoid setup() {\n    Serial.begin(115200);\n    if (!SD.begin(SD_CS)) {\n        Serial.println("SD Card Mount Failed!");\n        return;\n    }\n    Serial.println("SD Card initialized");\n    File file = SD.open("/data.csv", FILE_APPEND);\n    if (!file) {\n        file = SD.open("/data.csv", FILE_WRITE);\n        if (file) file.println("timestamp,sensor_value,voltage");\n    }\n    file.close();\n}\n\nvoid logData() {\n    int raw = analogRead(SENSOR_PIN);\n    float voltage = raw / 4095.0 * 3.3;\n    String line = String(millis()) + "," + String(raw) + "," + String(voltage, 3);\n    File file = SD.open("/data.csv", FILE_APPEND);\n    if (file) {\n        file.println(line);\n        file.close();\n        Serial.println("Logged: " + line);\n    }\n}\n\nvoid loop() {\n    if (millis() - lastLog > LOG_INTERVAL) {\n        lastLog = millis();\n        logData();\n    }\n}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# SD Card Data Logger\n\nproject_name: data_logger\nversion: 1.0.0\nboard: esp32\nbinary_path: build/data_logger.bin\n\nlibraries:\n  - name: SD\n    version: 2.0.0\n\nbuild:\n  optimization: -Os\n  debug: false\n', type: 'tbin' }
            ]
        }
    };

    function getAll() {
        return Object.keys(templates).map(function(key) {
            var t = templates[key];
            return { id: key, name: t.name, description: t.description, board: t.board, fileCount: t.files.length };
        });
    }

    function getTemplate(id) { return templates[id] || null; }

    function createFromTemplate(id, projectName) {
        var t = templates[id];
        if (!t) return null;
        var pid = 'p_' + Date.now();
        var files = t.files.map(function(f) { return { path: f.path, content: f.content, type: f.type }; });
        var proj = {
            id: pid, name: projectName || t.name, board: t.board,
            created: new Date().toISOString(), updated: new Date().toISOString(),
            files: files, libraries: [],
            tbin: files.find(function(f) { return f.type === 'tbin'; }) || null,
            github_url: null, template: id
        };
        return proj;
    }

    function renderList() {
        var all = getAll();
        var html = '<div class="template-grid">';
        for (var i = 0; i < all.length; i++) {
            var t = all[i];
            html += '<div class="template-card" onclick="ProjectTemplates.createFrom(\'' + t.id + '\')">';
            html += '<div class="template-icon">';
            if (t.id.indexOf('wifi') !== -1 || t.id.indexOf('web') !== -1) html += '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0M8.53 16.11a6 6 0 016.95 0M12 20h.01"/></svg>';\n            else if (t.id.indexOf('sleep') !== -1) html += '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';\n            else html += '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>';\n            html += '</div>';\n            html += '<div class="template-name">' + t.name + '</div>';\n            html += '<div class="template-desc">' + t.description + '</div>';\n            html += '<div class="template-meta"><span>' + t.fileCount + ' files</span><span>' + t.board.toUpperCase() + '</span></div>';\n            html += '</div>';\n        }\n        html += '</div>';\n        return html;\n    }\n\n    function createFrom(id) {\n        var t = templates[id];\n        if (!t) return;\n        document.getElementById('modalTitle').textContent = 'Create from Template: ' + t.name;\n        var html = '<div class="form-group"><label>Project Name</label><input type="text" id="templateProjectName" value="' + t.name.replace(/\\s+/g, '_').toLowerCase() + '" placeholder="my-project"></div>';\n        html += '<div class="form-group"><label>Target Board</label><select id="templateBoard"></select></div>';\n        html += '<p style="font-size:11px;color:var(--text-muted);margin-top:8px">This will create ' + t.files.length + ' files with pre-written code.</p>';\n        document.getElementById('modalBody').innerHTML = html;\n        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Cancel</button><button class="btn btn-neon" onclick="ProjectTemplates.doCreate(\'' + id + '\')">Create Project</button>';\n        var s = document.getElementById('templateBoard');\n        for (var g in IDE.BOARDS || {}) {\n            var og = document.createElement('optgroup');\n            og.label = g;\n            (IDE.BOARDS[g] || []).forEach(function(id2) {\n                var o = document.createElement('option');\n                o.value = id2;\n                o.textContent = IDE.getBN ? IDE.getBN(id2) : id2;\n                if (id2 === t.board) o.selected = true;\n                og.appendChild(o);\n            });\n            s.appendChild(og);\n        }\n        document.getElementById('modalOverlay').classList.add('visible');\n    }\n\n    function doCreate(id) {\n        var name = document.getElementById('templateProjectName').value.trim();\n        var board = document.getElementById('templateBoard').value;\n        if (!name) { alert('Project name required'); return; }\n        var proj = createFromTemplate(id, name);\n        if (!proj) return;\n        proj.board = board;\n        IDE.projects[proj.id] = proj;\n        IDE.saveProjects();\n        IDE.loadProject(proj.id);\n        IDE.closeModal();\n        Terminal.log('Created project from template: ' + proj.name, 'success');\n    }\n\n    function showSelector() {\n        document.getElementById('modalTitle').textContent = 'Project Templates';\n        document.getElementById('modalBody').innerHTML = renderList();\n        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';\n        document.getElementById('modalOverlay').classList.add('visible');\n    }\n\n    return { getAll: getAll, getTemplate: getTemplate, createFromTemplate: createFromTemplate, renderList: renderList, createFrom: createFrom, doCreate: doCreate, showSelector: showSelector };\n})();\n\n/* ===================== CODE FORMATTER ===================== */\nvar CodeFormatter = (function() {\n    function formatCpp(code) {\n        var lines = code.split('\\n');\n        var result = [];\n        var indent = 0;\n        var inBlockComment = false;\n        var inString = false;\n        var braceOnLine = false;\n\n        for (var i = 0; i < lines.length; i++) {\n            var line = lines[i].trim();\n            if (!line) { result.push(''); continue; }\n            if (line[0] === '#') { result.push(line); continue; }\n            if (line.indexOf('//') === 0) { result.push(spaces(indent * 4) + line); continue; }\n\n            var closingBraces = 0;\n            var openingBraces = 0;\n            var cleanLine = '';\n            var inStr = false;\n            var prevChar = '';\n\n            for (var j = 0; j < line.length; j++) {\n                var c = line[j];\n                if (inStr) {\n                    cleanLine += c;\n                    if (c === '"' && prevChar !== '\\\\') inStr = false;\n                } else {\n                    if (c === '"') { inStr = true; cleanLine += c; }\n                    else if (c === '{') { openingBraces++; cleanLine += c; }\n                    else if (c === '}') { closingBraces++; cleanLine += c; }\n                    else cleanLine += c;\n                }\n                prevChar = c;\n            }\n\n            indent = Math.max(0, indent - closingBraces);\n            var formatted = spaces(indent * 4) + cleanLine.trim();\n            result.push(formatted);\n            indent += openingBraces;\n        }\n\n        return result.join('\\n');\n    }\n\n    function formatJson(code) {\n        try {\n            return JSON.stringify(JSON.parse(code), null, 4);\n        } catch(e) {\n            return code;\n        }\n    }\n\n    function format(code, lang) {\n        if (!code) return '';\n        if (lang === 'json' || (typeof editor !== 'undefined' && editor && editor.session.getMode().$id.indexOf('json') !== -1)) return formatJson(code);\n        return formatCpp(code);\n    }\n\n    function spaces(n) {\n        var s = '';\n        for (var i = 0; i < n; i++) s += ' ';\n        return s;\n    }\n\n    function formatCurrentFile() {\n        if (typeof editor === 'undefined' || !editor) return;\n        var content = editor.getValue();\n        var formatted = format(content);\n        if (formatted !== content) {\n            editor.setValue(formatted, -1);\n            Terminal.log('Code formatted', 'success');\n        }\n    }\n\n    return { format: format, formatCpp: formatCpp, formatJson: formatJson, formatCurrentFile: formatCurrentFile };\n})();\n\n/* ===================== KEYBOARD SHORTCUT MANAGER ===================== */\nvar ShortcutManager = (function() {\n    var shortcuts = JSON.parse(localStorage.getItem('tb_shortcuts') || '{}');\n    var defaults = {\n        'Ctrl+S': 'save', 'Ctrl+N': 'newFile', 'Ctrl+W': 'closeTab',\n        'Ctrl+H': 'findReplace', 'Ctrl+`': 'toggleTerminal', 'F5': 'compile',\n        'Ctrl+Shift+P': 'commandPalette', 'Ctrl+Shift+E': 'explorer',\n        'Ctrl+Shift+F': 'search', 'Ctrl+Z': 'undo', 'Ctrl+Y': 'redo',\n        'Ctrl+A': 'selectAll', 'Ctrl+D': 'duplicateLine', 'Ctrl+/': 'toggleComment',\n        'Ctrl+Shift+K': 'deleteLine', 'Alt+Up': 'moveLineUp', 'Alt+Down': 'moveLineDown',\n        'Ctrl+F': 'find', 'Ctrl+G': 'goToLine', 'Ctrl+Shift+D': 'debug',\n        'Ctrl+B': 'toggleSidebar', 'Ctrl+M': 'toggleMinimap', 'Ctrl+Shift+T': 'templates'\n    };\n\n    function getAll() {\n        var all = [];\n        for (var key in defaults) {\n            all.push({ shortcut: shortcuts[key] || key, action: defaults[key], isDefault: !shortcuts[key] });\n        }\n        return all;\n    }\n\n    function set(shortcut, action) {\n        shortcuts[shortcut] = action;\n        localStorage.setItem('tb_shortcuts', JSON.stringify(shortcuts));\n    }\n\n    function reset() {\n        shortcuts = {};\n        localStorage.removeItem('tb_shortcuts');\n    }\n\n    function showEditor() {\n        var all = getAll();\n        var html = '<div class="keybindings-grid">';\n        for (var i = 0; i < all.length; i++) {\n            html += '<div class="keybinding-item">';\n            html += '<span class="kb-label">' + all[i].action + '</span>';\n            html += '<kbd>' + all[i].shortcut + '</kbd>';\n            html += '</div>';\n        }\n        html += '</div>';\n        document.getElementById('modalTitle').textContent = 'Keyboard Shortcuts';\n        document.getElementById('modalBody').innerHTML = html;\n        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-danger btn-sm" onclick="ShortcutManager.reset();ShortcutManager.showEditor()">Reset</button><button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';\n        document.getElementById('modalOverlay').classList.add('visible');\n    }\n\n    return { getAll: getAll, set: set, reset: reset, showEditor: showEditor };\n})();\n\n/* ===================== BOARD CONFIG GENERATOR ===================== */\nvar BoardConfig = (function() {\n    function generate(boardId) {\n        var info = BoardManager.getBoardInfo(boardId);\n        if (!info) return null;\n        var config = {\n            board: boardId,\n            board_name: info.name,\n            mcu: info.mcu,\n            flash_size: info.flash,\n            sram_size: info.sram,\n            clock_speed: info.clock,\n            cores: info.cores,\n            voltage: info.voltage,\n            features: {},\n            pins: { gpio: info.pins, adc: info.adc, dac: info.dac, i2c: info.i2c, spi: info.spi, uart: info.uart, pwm: info.pwm },\n            frameworks: info.frameworks,\n            platformio_id: info.platformio_id,\n            arduino_compat: info.arduino_compat,\n            ota_support: info.ota,\n            low_power: info.low_power,\n            deep_sleep: info.deep_sleep\n        };\n        if (info.wifi) config.features.wifi = true;\n        if (info.ble) config.features.ble = true;\n        if (info.bluetooth) config.features.bluetooth = true;\n        if (info.ethernet) config.features.ethernet = true;\n        if (info.thread) config.features.thread = true;\n        if (info.zigbee) config.features.zigbee = true;\n        if (info.usb) config.features.usb = info.usb;\n        if (info.display) config.features.display = info.display;\n        if (info.battery) config.features.battery = info.battery;\n        if (info.imu) config.features.imu = info.imu;\n        if (info.rgb_led) config.features.rgb_led = true;\n        if (info.shields) config.features.shields = true;\n        if (info.stemma_qt) config.features.stemma_qt = true;\n        if (info.neopixel) config.features.neopixel = true;\n        if (info.led_matrix) config.features.led_matrix = info.led_matrix;\n        if (info.buttons) config.features.buttons = info.buttons;\n        if (info.compass) config.features.compass = true;\n        if (info.accelerometer) config.features.accelerometer = true;\n        if (info.microphone) config.features.microphone = true;\n        if (info.cloud) config.features.cloud = true;\n        if (info.mesh) config.features.mesh = true;\n        if (info.ai_accel) config.features.ai_accel = true;\n        if (info.riscv) config.features.riscv = true;\n        if (info.low_power_optimized) config.features.low_power_optimized = true;\n        return config;\n    }\n\n    function generatePlatformioIni(boardId) {\n        var config = generate(boardId);\n        if (!config) return '';\n        var ini = '[env:' + config.platformio_id + ']\\n';\n        ini += 'platform = espressif32\\n';\n        ini += 'board = ' + config.platformio_id + '\\n';\n        ini += 'framework = arduino\\n';\n        ini += 'monitor_speed = 115200\\n';\n        ini += 'upload_speed = 921600\\n';\n        ini += 'lib_deps =\\n';\n        ini += '    WiFi\\n';\n        return ini;\n    }\n\n    function generateMakefile(boardId) {\n        var config = generate(boardId);\n        if (!config) return '';\n        var mk = '# Makefile for ' + config.board_name + '\\n';\n        mk += 'BOARD = ' + config.board + '\\n';\n        mk += 'MCU = ' + config.mcu + '\\n';\n        mk += 'FLASH_SIZE = ' + config.flash_size + '\\n';\n        mk += 'CLOCK = ' + config.clock_speed + '\\n';\n        mk += 'CC = xtensa-esp32-elf-gcc\\n';\n        mk += 'CFLAGS = -Os -DF_CPU=' + parseInt(config.clock_speed) + '000000L\\n';\n        mk += 'LDFLAGS = -T esp32_out.ld\\n';\n        mk += '\\nall: build\\n';\n        mk += '\\nbuild:\\n';\n        mk += '\\t$(CC) $(CFLAGS) -o firmware.elf src/*.c\\n';\n        mk += '\\nflash: build\\n';\n        mk += '\\tesptool write_flash 0x1000 firmware.bin\\n';\n        mk += '\\nclean:\\n';\n        mk += '\\trm -f *.elf *.bin\\n';\n        return mk;\n    }\n\n    function showGenerator() {\n        var html = '<div class="form-group"><label>Select Board</label><select id="configBoard"></select></div>';\n        html += '<div class="form-group"><label>Output Format</label><select id="configFormat"><option value="json">JSON Config</option><option value="platformio">platformio.ini</option><option value="makefile">Makefile</option><option value="cmake">CMakeLists.txt</option></select></div>';\n        html += '<button class="btn btn-neon btn-sm btn-block" onclick="BoardConfig.doGenerate()">Generate</button>';\n        html += '<div id="configOutput" style="margin-top:12px"></div>';\n        document.getElementById('modalTitle').textContent = 'Board Config Generator';\n        document.getElementById('modalBody').innerHTML = html;\n        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';\n        var s = document.getElementById('configBoard');\n        var all = BoardManager.getAllBoards();\n        for (var i = 0; i < all.length; i++) {\n            var o = document.createElement('option');\n            o.value = all[i].id;\n            o.textContent = all[i].name;\n            s.appendChild(o);\n        }\n        document.getElementById('modalOverlay').classList.add('visible');\n    }\n\n    function doGenerate() {\n        var boardId = document.getElementById('configBoard').value;\n        var format = document.getElementById('configFormat').value;\n        var output = '';\n        if (format === 'json') output = JSON.stringify(generate(boardId), null, 2);\n        else if (format === 'platformio') output = generatePlatformioIni(boardId);\n        else if (format === 'makefile') output = generateMakefile(boardId);\n        else if (format === 'cmake') output = 'cmake_minimum_required(VERSION 3.16)\\nproject(' + boardId + ')\\nadd_executable(firmware src/main.cpp)';\n        document.getElementById('configOutput').innerHTML = '<pre style="background:var(--bg-tertiary);padding:12px;border-radius:var(--radius-md);font-family:var(--font-mono);font-size:12px;max-height:300px;overflow:auto;white-space:pre-wrap">' + escapeHtml(output) + '</pre>';\n    }\n\n    function escapeHtml(s) {\n        var d = document.createElement('div');\n        d.textContent = s;\n        return d.innerHTML;\n    }\n\n    return { generate: generate, generatePlatformioIni: generatePlatformioIni, generateMakefile: generateMakefile, showGenerator: showGenerator, doGenerate: doGenerate };\n})();\n\n/* ===================== THEME CUSTOMIZER ===================== */\nvar ThemeCustomizer = (function() {\n    var customColors = JSON.parse(localStorage.getItem('tb_theme_colors') || '{}');\n\n    var colorPresets = {\n        'catppuccin-mocha': { bg: '#1e1e2e', bgSecondary: '#181825', bgTertiary: '#11111b', bgInput: '#313244', border: '#45475a', text: '#cdd6f4', textSecondary: '#a6adc8', neon: '#89b4fa', green: '#a6e3a1', red: '#f38ba8', orange: '#fab387', purple: '#cba6f7', yellow: '#f9e2af' },\n        'tokyo-night': { bg: '#1a1b26', bgSecondary: '#16161e', bgTertiary: '#13131a', bgInput: '#24283b', border: '#3b4261', text: '#c0caf5', textSecondary: '#a9b1d6', neon: '#7aa2f7', green: '#9ece6a', red: '#f7768e', orange: '#ff9e64', purple: '#bb9af7', yellow: '#e0af68' },\n        'dracula': { bg: '#282a36', bgSecondary: '#21222c', bgTertiary: '#191a21', bgInput: '#44475a', border: '#6272a4', text: '#f8f8f2', textSecondary: '#bd93f9', neon: '#8be9fd', green: '#50fa7b', red: '#ff5555', orange: '#ffb86c', purple: '#bd93f9', yellow: '#f1fa8c' },\n        'nord': { bg: '#2e3440', bgSecondary: '#3b4252', bgTertiary: '#272c36', bgInput: '#4c566a', border: '#4c566a', text: '#eceff4', textSecondary: '#d8dee9', neon: '#88c0d0', green: '#a3be8c', red: '#bf616a', orange: '#d08770', purple: '#b48ead', yellow: '#ebcb8b' },\n        'monokai': { bg: '#272822', bgSecondary: '#1e1f1c', bgTertiary: '#171814', bgInput: '#3e3d32', border: '#75715e', text: '#f8f8f2', textSecondary: '#a6a48e', neon: '#66d9ef', green: '#a6e22e', red: '#f92672', orange: '#fd971f', purple: '#ae81ff', yellow: '#e6db74' },\n        'solarized-dark': { bg: '#002b36', bgSecondary: '#073642', bgTertiary: '#001e27', bgInput: '#586e75', border: '#586e75', text: '#839496', textSecondary: '#93a1a1', neon: '#268bd2', green: '#859900', red: '#dc322f', orange: '#cb4b16', purple: '#6c71c4', yellow: '#b58900' }\n    };\n\n    function applyPreset(name) {\n        var preset = colorPresets[name];\n        if (!preset) return;\n        customColors = preset;\n        localStorage.setItem('tb_theme_colors', JSON.stringify(customColors));\n        applyCustomTheme();\n        Terminal.log('Theme preset applied: ' + name, 'success');\n    }\n\n    function applyCustomTheme() {\n        var root = document.documentElement;\n        if (customColors.bg) root.style.setProperty('--bg', customColors.bg);\n        if (customColors.bgSecondary) root.style.setProperty('--bg-secondary', customColors.bgSecondary);\n        if (customColors.bgTertiary) root.style.setProperty('--bg-tertiary', customColors.bgTertiary);\n        if (customColors.bgInput) root.style.setProperty('--bg-input', customColors.bgInput);\n        if (customColors.border) root.style.setProperty('--border', customColors.border);\n        if (customColors.text) root.style.setProperty('--text', customColors.text);\n        if (customColors.textSecondary) root.style.setProperty('--text-secondary', customColors.textSecondary);\n        if (customColors.neon) root.style.setProperty('--neon', customColors.neon);\n        if (customColors.green) root.style.setProperty('--green', customColors.green);\n        if (customColors.red) root.style.setProperty('--red', customColors.red);\n        if (customColors.orange) root.style.setProperty('--orange', customColors.orange);\n        if (customColors.purple) root.style.setProperty('--purple', customColors.purple);\n        if (customColors.yellow) root.style.setProperty('--yellow', customColors.yellow);\n    }\n\n    function showCustomizer() {\n        var html = '<div class="form-group"><label>Theme Presets</label><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">';\n        var presets = Object.keys(colorPresets);\n        for (var i = 0; i < presets.length; i++) {\n            html += '<button class="btn btn-sm btn-ghost btn-block" onclick="ThemeCustomizer.applyPreset(\\'' + presets[i] + '\\');ThemeCustomizer.showCustomizer()">' + presets[i] + '</button>';\n        }\n        html += '</div></div>';\n        html += '<div class="form-group"><label>Custom Colors</label>';\n        var colors = ['bg', 'bgSecondary', 'bgTertiary', 'bgInput', 'border', 'text', 'textSecondary', 'neon', 'green', 'red', 'orange', 'purple', 'yellow'];\n        for (var j = 0; j < colors.length; j++) {\n            var c = colors[j];\n            html += '<div class="setting-row"><label>' + c + '</label><input type="color" value="' + (customColors[c] || '#1e1e2e') + '" onchange="ThemeCustomizer.setColor(\\'' + c + '\\', this.value)"></div>';\n        }\n        html += '</div>';\n        html += '<button class="btn btn-neon btn-sm btn-block" onclick="ThemeCustomizer.applyCustomTheme()">Apply Colors</button>';\n        document.getElementById('modalTitle').textContent = 'Theme Customizer';\n        document.getElementById('modalBody').innerHTML = html;\n        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';\n        document.getElementById('modalOverlay').classList.add('visible');\n    }\n\n    function setColor(name, value) {\n        customColors[name] = value;\n    }\n\n    function resetTheme() {\n        customColors = {};\n        localStorage.removeItem('tb_theme_colors');\n        document.documentElement.removeAttribute('style');\n        Terminal.log('Theme reset to default', 'info');\n    }\n\n    return { applyPreset: applyPreset, applyCustomTheme: applyCustomTheme, showCustomizer: showCustomizer, setColor: setColor, resetTheme: resetTheme, colorPresets: colorPresets };\n})();\n\n/* ===================== ENHANCED TODO WITH TAGS ===================== */\nvar EnhancedTODO = (function() {\n    var todos = [];\n    var currentFilter = 'all';\n    var currentTag = 'all';\n    var searchQuery = '';\n\n    function init() {\n        loadTodos();\n        render();\n    }\n\n    function loadTodos() {\n        try {\n            var s = localStorage.getItem('tb_todos_v2');\n            if (s) todos = JSON.parse(s);\n        } catch(e) { todos = []; }\n    }\n\n    function saveTodos() {\n        localStorage.setItem('tb_todos_v2', JSON.stringify(todos));\n    }\n\n    function add(text, priority, tags, dueDate) {\n        if (!text) return;\n        todos.push({\n            id: 't_' + Date.now(),\n            text: text,\n            priority: priority || 'medium',\n            tags: tags || [],\n            dueDate: dueDate || null,\n            done: false,\n            created: new Date().toISOString(),\n            completed: null,\n            projectId: IDE.currentProject ? IDE.currentProject.id : null\n        });\n        saveTodos();\n        render();\n    }\n\n    function toggle(id) {\n        for (var i = 0; i < todos.length; i++) {\n            if (todos[i].id === id) {\n                todos[i].done = !todos[i].done;\n                todos[i].completed = todos[i].done ? new Date().toISOString() : null;\n                break;\n            }\n        }\n        saveTodos();\n        render();\n    }\n\n    function remove(id) {\n        todos = todos.filter(function(t) { return t.id !== id; });\n        saveTodos();\n        render();\n    }\n\n    function edit(id, newText) {\n        for (var i = 0; i < todos.length; i++) {\n            if (todos[i].id === id) {\n                todos[i].text = newText;\n                break;\n            }\n        }\n        saveTodos();\n        render();\n    }\n\n    function setFilter(f) {\n        currentFilter = f;\n        render();\n    }\n\n    function setTag(t) {\n        currentTag = t;\n        render();\n    }\n\n    function setSearch(q) {\n        searchQuery = q;\n        render();\n    }\n\n    function getAllTags() {\n        var tags = {};\n        for (var i = 0; i < todos.length; i++) {\n            for (var j = 0; j < todos[i].tags.length; j++) {\n                var t = todos[i].tags[j];\n                tags[t] = (tags[t] || 0) + 1;\n            }\n        }\n        return tags;\n    }\n\n    function getFiltered() {\n        var filtered = todos;\n        if (currentFilter === 'pending') filtered = filtered.filter(function(t) { return !t.done; });\n        else if (currentFilter === 'done') filtered = filtered.filter(function(t) { return t.done; });\n        else if (currentFilter === 'overdue') {\n            var now = new Date();\n            filtered = filtered.filter(function(t) { return t.dueDate && new Date(t.dueDate) < now && !t.done; });\n        }\n        if (currentTag !== 'all') filtered = filtered.filter(function(t) { return t.tags.indexOf(currentTag) !== -1; });\n        if (searchQuery) {\n            var q = searchQuery.toLowerCase();\n            filtered = filtered.filter(function(t) { return t.text.toLowerCase().indexOf(q) !== -1 || t.tags.join(' ').toLowerCase().indexOf(q) !== -1; });\n        }\n        return filtered;\n    }\n\n    function clearDone() {\n        todos = todos.filter(function(t) { return !t.done; });\n        saveTodos();\n        render();\n    }\n\n    function clear() {\n        todos = [];\n        saveTodos();\n        render();\n    }\n\n    function exportTodos() {\n        var data = JSON.stringify(todos, null, 2);\n        var blob = new Blob([data], { type: 'application/json' });\n        var a = document.createElement('a');\n        a.href = URL.createObjectURL(blob);\n        a.download = 'todos_' + Date.now() + '.json';\n        a.click();\n    }\n\n    function render() {\n        var listEl = document.getElementById('todoList');\n        if (!listEl) return;\n        var filtered = getFiltered();\n        var total = todos.length;\n        var done = todos.filter(function(t) { return t.done; }).length;\n        var pending = total - done;\n        var overdue = todos.filter(function(t) { return t.dueDate && new Date(t.dueDate) < new Date() && !t.done; }).length;\n\n        var totalEl = document.getElementById('todoTotal');\n        var pendingEl = document.getElementById('todoPending');\n        var doneEl = document.getElementById('todoDone');\n        var badge = document.getElementById('todoBadge');\n        if (totalEl) totalEl.textContent = total;\n        if (pendingEl) pendingEl.textContent = pending;\n        if (doneEl) doneEl.textContent = done;\n        if (badge) {\n            if (pending > 0) { badge.style.display = ''; badge.textContent = pending > 99 ? '99+' : pending; }\n            else { badge.style.display = 'none'; }\n        }\n\n        var tags = getAllTags();\n        var tagHtml = '<button class="todo-filter' + (currentTag === 'all' ? ' active' : '') + '" onclick="EnhancedTODO.setTag(\\'all\\')">All</button>';\n        for (var tag in tags) {\n            tagHtml += '<button class="todo-filter' + (currentTag === tag ? ' active' : '') + '" onclick="EnhancedTODO.setTag(\\'' + tag + '\\')">' + tag + ' (' + tags[tag] + ')</button>';\n        }\n        var tagContainer = document.getElementById('todoTags');\n        if (tagContainer) tagContainer.innerHTML = tagHtml;\n\n        if (filtered.length === 0) {\n            listEl.innerHTML = '<div class="todo-empty">No tasks' + (searchQuery ? ' matching "' + searchQuery + '"' : '') + '</div>';\n            return;\n        }\n\n        var html = '';\n        for (var i = 0; i < filtered.length; i++) {\n            var t = filtered[i];\n            var isOverdue = t.dueDate && new Date(t.dueDate) < new Date() && !t.done;\n            html += '<div class="todo-item priority-' + t.priority + (t.done ? ' done' : '') + (isOverdue ? ' overdue' : '') + '">';\n            html += '<input type="checkbox" class="todo-checkbox" ' + (t.done ? 'checked' : '') + ' onclick="EnhancedTODO.toggle(\\'' + t.id + '\\')">';\n            html += '<div class="todo-content"><div class="todo-text">' + escapeHtml(t.text) + '</div>';\n            html += '<div class="todo-meta">';\n            html += '<span class="todo-priority ' + t.priority + '">' + t.priority + '</span>';\n            if (t.tags.length > 0) {\n                for (var ti = 0; ti < t.tags.length; ti++) {\n                    html += '<span class="todo-tag">' + escapeHtml(t.tags[ti]) + '</span>';\n                }\n            }\n            if (t.dueDate) {\n                html += '<span class="todo-date' + (isOverdue ? ' overdue' : '') + '">' + new Date(t.dueDate).toLocaleDateString() + '</span>';\n            }\n            html += '</div></div>';\n            html += '<div class="todo-actions">';\n            html += '<button class="todo-action" onclick="EnhancedTODO.editPrompt(\\'' + t.id + '\\')" title="Edit">e</button>';\n            html += '<button class="todo-action delete" onclick="EnhancedTODO.remove(\\'' + t.id + '\\')" title="Delete">x</button>';\n            html += '</div></div>';\n        }\n        listEl.innerHTML = html;\n    }\n\n    function editPrompt(id) {\n        var t = null;\n        for (var i = 0; i < todos.length; i++) { if (todos[i].id === id) { t = todos[i]; break; } }\n        if (!t) return;\n        var newText = prompt('Edit task:', t.text);\n        if (newText && newText.trim()) edit(id, newText.trim());\n    }\n\n    function escapeHtml(s) {\n        var d = document.createElement('div');\n        d.textContent = s;\n        return d.innerHTML;\n    }\n\n    return { init: init, add: add, toggle: toggle, remove: remove, edit: edit, editPrompt: editPrompt, setFilter: setFilter, setTag: setTag, setSearch: setSearch, clearDone: clearDone, clear: clear, exportTodos: exportTodos, render: render, getFiltered: getFiltered };\n})();\n\n/* ===================== INIT ===================== */
CommandPalette.init();
FileHistory.init();
document.addEventListener('DOMContentLoaded', function() {
    IDE.init();
    SerialPlotter.init();
    window.addEventListener('resize', function() { SerialPlotter.resize(); });
});
