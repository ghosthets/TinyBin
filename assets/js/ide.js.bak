                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <driver/rtc_io.h>\n\n#define WAKEUP_PIN 33\n#define SLEEP_TIME_US 30000000  // 30 seconds\n#define LED_PIN LED_BUILTIN\n\nRTC_DATA_ATTR int bootCount = 0;\n\nvoid printWakeReason() {\n    esp_sleep_wakeup_cause_t cause = esp_sleep_get_wakeup_cause();\n    switch (cause) {\n        case ESP_SLEEP_WAKEUP_EXT0: Serial.println("Wakeup: External signal"); break;\n        case ESP_SLEEP_WAKEUP_EXT1: Serial.println("Wakeup: External signal (multi)"); break;\n        case ESP_SLEEP_WAKEUP_TIMER: Serial.println("Wakeup: Timer"); break;\n        case ESP_SLEEP_WAKEUP_TOUCHPAD: Serial.println("Wakeup: Touchpad"); break;\n        case ESP_SLEEP_WAKEUP_ULP: Serial.println("Wakeup: ULP program"); break;\n        default: Serial.println("Wakeup: Not deep sleep"); break;\n    }\n}\n\nvoid setup() {\n    Serial.begin(115200);\n    ++bootCount;\n    Serial.println("Boot #" + String(bootCount));\n    printWakeReason();\n    pinMode(LED_PIN, OUTPUT);\n    digitalWrite(LED_PIN, HIGH);\n    delay(200);\n    digitalWrite(LED_PIN, LOW);\n    Serial.println("Reading sensors...");\n    float battery = analogRead(35) / 4095.0 * 3.3 * 2;\n    Serial.printf("Battery: %.2fV\\n", battery);\n    Serial.println("Going to sleep for 30s...");\n    delay(100);\n    esp_sleep_enable_timer_wakeup(SLEEP_TIME_US);\n    esp_deep_sleep_start();\n}\n\nvoid loop() {}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# Deep Sleep Sensor\n\nproject_name: deep_sleep\nversion: 1.0.0\nboard: esp32\nbinary_path: build/deep_sleep.bin\n\nbuild:\n  optimization: -Os\n  debug: false\n  flash_freq: 80m\n', type: 'tbin' }
