        'nodemcu': {name:'NodeMCU 1.0',family:'ESP8266',mcu:'ESP8266EX',flash:'4MB',sram:'80KB',psram:'None',clock:'80MHz',cores:1,voltage:'3.3V',usb:'Micro-B',wifi:true,ble:false,pins:17,adc:1,dac:0,i2c:1,spi:1,uart:1,can:false,sdmmc:false,touch:0,pwm:8,ethernet:false,debug:'Limited',ota:true,low_power:false,deep_sleep:true,arduino_compat:true,platformio_id:'nodemcuv2',frameworks:['Arduino','ESP8266 RTOS SDK'],price:'$3-5'},
        'huzzah32': {name:'Adafruit HUZZAH32',family:'ESP32',mcu:'ESP32-D0WDQ6',flash:'4MB',sram:'520KB',psram:'None',clock:'240MHz',cores:2,voltage:'3.3V',usb:'C-Type',wifi:true,ble:true,pins:27,adc:18,dac:2,i2c:2,spi:3,uart:3,can:false,sdmmc:false,touch:10,pwm:16,ethernet:false,debug:'JTAG',ota:true,low_power:true,deep_sleep:true,arduino_compat:true,platformio_id:'feather_esp32',frameworks:['Arduino','ESP-IDF'],price:'$15-20',battery:'LiPo',stemma_qt:true},
        'particle_argon': {name:'Particle Argon',family:'nRF52',mcu:'nRF52840',flash:'1MB',sram:'256KB',psram:'None',clock:'64MHz',cores:1,voltage:'3.3V',usb:'Micro-B',wifi:true,ble:true,mesh:true,pins:22,adc:6,dac:0,i2c:1,spi:1,uart:1,can:false,sdmmc:false,touch:0,pwm:8,ethernet:false,debug:'SWD',ota:true,low_power:true,deep_sleep:true,arduino_compat:true,platformio_id:'particle_argon',frameworks:['Arduino','Particle OS'],price:'$15-20',cloud:true},
        'adafruit_feather_rp2040': {name:'Feather RP2040',family:'RP2040',mcu:'RP2040',flash:'8MB',sram:'264KB',psram:'None',clock:'125MHz',cores:2,voltage:'3.3V',usb:'C-Type',wifi:false,ble:false,pins:22,adc:4,dac:0,i2c:2,spi:2,uart:2,can:false,sdmmc:false,touch:0,pwm:16,ethernet:false,debug:'SWD',ota:false,low_power:true,deep_sleep:true,arduino_compat:true,platformio_id:'adafruit_feather_rp2040',frameworks:['Arduino','CircuitPython','MicroPython'],price:'$10-14',battery:'LiPo',stemma_qt:true,neopixel:true},
    };

    function getBoardInfo(id) {
        return BOARD_INFO[id] || null;
    }

    function getAllBoards() {
        return Object.keys(BOARD_INFO).map(function(id) {
            var info = BOARD_INFO[id];
            return { id: id, name: info.name, family: info.family, price: info.price, wifi: info.wifi, ble: info.ble, cores: info.cores, clock: info.clock };
        });
    }

    function searchBoards(q) {
        if (!q) return getAllBoards();
        var lower = q.toLowerCase();
        return getAllBoards().filter(function(b) {
            return b.id.toLowerCase().indexOf(lower) !== -1 || b.name.toLowerCase().indexOf(lower) !== -1 || b.family.toLowerCase().indexOf(lower) !== -1;
        });
    }

    function filterByFeature(feature) {
        return getAllBoards().filter(function(b) {
            var info = BOARD_INFO[b.id];
            return info[feature] === true;
        });
    }

    function compareBoards(id1, id2) {
        var b1 = BOARD_INFO[id1], b2 = BOARD_INFO[id2];
        if (!b1 || !b2) return null;
        return {
            board1: { id: id1, name: b1.name },
            board2: { id: id2, name: b2.name },
            differences: {},
            similarities: {}
        };
    }

    function addToFavorites(id) {
        if (favorites.indexOf(id) === -1) {
            favorites.push(id);
            localStorage.setItem('tb_board_favorites', JSON.stringify(favorites));
        }
    }

    function removeFromFavorites(id) {
        favorites = favorites.filter(function(f) { return f !== id; });
        localStorage.setItem('tb_board_favorites', JSON.stringify(favorites));
    }

    function isFavorite(id) {
        return favorites.indexOf(id) !== -1;
    }

    function getFavorites() {
        return favorites.map(function(id) { return BOARD_INFO[id]; }).filter(function(b) { return b; });
    }

    function generatePinout(id) {
        var info = BOARD_INFO[id];
        if (!info) return null;
        var pinout = { name: info.name, total_pins: info.pins, gpio: [], analog: [], power: [], communication: [] };
        var gpioCount = info.pins - (info.adc || 0) - 4;
        for (var i = 0; i < gpioCount; i++) { pinout.gpio.push('GPIO' + i); }
        for (var a = 0; a < (info.adc || 0); a++) { pinout.analog.push('A' + a); }
        pinout.power = ['3V3', '5V', 'GND', 'GND', 'VIN'];
        if (info.i2c) { for (var ii = 0; ii < info.i2c; ii++) { pinout.communication.push('I2C' + ii + ' (SDA/SCL)'); } }
        if (info.spi) { for (var si = 0; si < info.spi; si++) { pinout.communication.push('SPI' + si + ' (MOSI/MISO/SCK)'); } }
        if (info.uart) { for (var ui = 0; ui < info.uart; ui++) { pinout.communication.push('UART' + ui + ' (TX/RX)'); } }
        return pinout;
    }

    function getRecommendedBoard(useCase) {
        var recommendations = {
            'wifi_iot': ['esp32', 'esp32c3', 'esp8266', 'pico_w'],
            'ble_sensor': ['esp32c3', 'nrf52840', 'bbc_microbit'],
            'display': ['esp32s3', 'm5stack_core', 'ttgo_tdisplay'],
            'low_power': ['esp32c3', 'rp2040', 'nrf52840'],
            'beginner': ['arduino_uno', 'esp32', 'bbc_microbit'],
            'advanced': ['esp32s3', 'stm32h743zi', 'teensy40'],
            'tiny': ['esp01', 'xiao_esp32c3', 'lolin_s2_mini'],
            'battery': ['m5stack_core', 'adafruit_feather_rp2040', 'huzzah32'],
            'mesh': ['particle_argon', 'esp32c6'],
            'ai_ml': ['esp32s3', 'teensy40'],
        };
        return recommendations[useCase] || ['esp32'];
    }

    function renderBoardCard(info) {
        if (!info) return '';
        var html = '<div class="board-card" data-board="' + info.id + '">';
        html += '<div class="board-card-header"><span class="board-name">' + info.name + '</span>';
        html += '<span class="board-family">' + info.family + '</span></div>';
        html += '<div class="board-specs">';
        html += '<div class="board-spec"><span class="spec-label">MCU</span><span class="spec-value">' + info.mcu + '</span></div>';
        html += '<div class="board-spec"><span class="spec-label">Flash</span><span class="spec-value">' + info.flash + '</span></div>';
        html += '<div class="board-spec"><span class="spec-label">SRAM</span><span class="spec-value">' + info.sram + '</span></div>';
        html += '<div class="board-spec"><span class="spec-label">Clock</span><span class="spec-value">' + info.clock + '</span></div>';
        html += '<div class="board-spec"><span class="spec-label">Cores</span><span class="spec-value">' + info.cores + '</span></div>';
        html += '<div class="board-spec"><span class="spec-label">Voltage</span><span class="spec-value">' + info.voltage + '</span></div>';
        html += '</div>';
        html += '<div class="board-features">';
        if (info.wifi) html += '<span class="feature-badge wifi">WiFi</span>';
        if (info.ble) html += '<span class="feature-badge ble">BLE</span>';
        if (info.usb) html += '<span class="feature-badge usb">USB</span>';
        if (info.ota) html += '<span class="feature-badge ota">OTA</span>';
        html += '</div>';
        html += '<div class="board-actions"><button class="btn btn-sm btn-ghost" onclick="BoardManager.selectBoard(\'' + info.id + '\')">Select</button>';
        html += '<button class="btn btn-sm btn-ghost" onclick="BoardManager.showDetails(\'' + info.id + '\')">Details</button></div>';
        html += '</div>';
        return html;
    }

    function selectBoard(id) {
        currentBoard = id;
        var info = BOARD_INFO[id];
        if (IDE.currentProject) {
            IDE.currentProject.board = id;
            IDE.currentProject.updated = new Date().toISOString();
            IDE.saveProjects();
        }
        var s = document.getElementById('boardSelect');
        if (s) s.value = id;
        Terminal.log('Board selected: ' + (info ? info.name : id), 'success');
    }

    function showDetails(id) {
        var info = BOARD_INFO[id];
        if (!info) return;
        var html = '<div class="board-details-modal">';
        html += '<h3 style="margin-bottom:12px">' + info.name + '</h3>';
        html += '<div class="board-detail-grid">';
        html += '<div class="detail-row"><span class="detail-label">Family</span><span class="detail-value">' + info.family + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">MCU</span><span class="detail-value">' + info.mcu + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Flash</span><span class="detail-value">' + info.flash + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">SRAM</span><span class="detail-value">' + info.sram + '</span></div>';
        if (info.psram) html += '<div class="detail-row"><span class="detail-label">PSRAM</span><span class="detail-value">' + info.psram + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Clock</span><span class="detail-value">' + info.clock + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Cores</span><span class="detail-value">' + info.cores + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Voltage</span><span class="detail-value">' + info.voltage + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Pins</span><span class="detail-value">' + info.pins + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">ADC</span><span class="detail-value">' + info.adc + ' channels</span></div>';
        html += '<div class="detail-row"><span class="detail-label">I2C</span><span class="detail-value">' + info.i2c + ' bus(es)</span></div>';
        html += '<div class="detail-row"><span class="detail-label">SPI</span><span class="detail-value">' + info.spi + ' bus(es)</span></div>';
        html += '<div class="detail-row"><span class="detail-label">UART</span><span class="detail-value">' + info.uart + ' port(s)</span></div>';
        html += '<div class="detail-row"><span class="detail-label">PWM</span><span class="detail-value">' + info.pwm + ' channels</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Frameworks</span><span class="detail-value">' + info.frameworks.join(', ') + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Price</span><span class="detail-value">' + info.price + '</span></div>';
        html += '</div></div>';
        document.getElementById('modalTitle').textContent = 'Board Details';
        document.getElementById('modalBody').innerHTML = html;
        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button><button class="btn btn-neon" onclick="BoardManager.selectBoard(\'' + id + '\');IDE.closeModal()">Select Board</button>';
        document.getElementById('modalOverlay').classList.add('visible');
    }

    return {
        getBoardInfo: getBoardInfo, getAllBoards: getAllBoards, searchBoards: searchBoards,
        filterByFeature: filterByFeature, compareBoards: compareBoards,
        addToFavorites: addToFavorites, removeFromFavorites: removeFromFavorites,
        isFavorite: isFavorite, getFavorites: getFavorites, generatePinout: generatePinout,
        getRecommendedBoard: getRecommendedBoard, renderBoardCard: renderBoardCard,
        selectBoard: selectBoard, showDetails: showDetails
    };
})();

/* ===================== SERIAL PLOTTER ===================== */
var SerialPlotter = (function() {
    var canvas, ctx;
    var data = {};
    var colors = ['#89b4fa', '#a6e3a1', '#fab387', '#f38ba8', '#cba6f7', '#f9e2af', '#94e2d5', '#f5c2e7'];
    var maxPoints = 200;
    var minY = 0, maxY = 1023;
    var running = false;
    var pointCount = 0;

    function init() {
        canvas = document.getElementById('plotterCanvas');
        if (!canvas) return;
        ctx = canvas.getContext('2d');
        resize();
        drawGrid();
    }

    function resize() {
        if (!canvas) return;
        var container = canvas.parentElement;
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight || 300;
        drawGrid();
    }

    function drawGrid() {
        if (!ctx || !canvas) return;
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--bg-tertiary').trim() || '#11111b';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--border-dark').trim() || '#313244';
        ctx.lineWidth = 0.5;
        var gridLines = 10;
        for (var i = 0; i <= gridLines; i++) {
            var y = (canvas.height / gridLines) * i;
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(canvas.width, y);
            ctx.stroke();
            var val = maxY - ((maxY - minY) / gridLines) * i;
            ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#6c7086';
            ctx.font = '10px JetBrains Mono';
            ctx.fillText(Math.round(val), 4, y - 2);
        }
        for (var j = 0; j <= gridLines; j++) {
            var x = (canvas.width / gridLines) * j;
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, canvas.height);
            ctx.stroke();
        }
    }

    function parseSerialData(line) {
        var values = [];
        var parts = line.split(/[,\s\t]+/);
        for (var i = 0; i < parts.length; i++) {
            var num = parseFloat(parts[i]);
            if (!isNaN(num)) values.push(num);
        }
        return values;
    }

    function addData(values) {
        for (var i = 0; i < values.length; i++) {
            var key = 'series_' + i;
            if (!data[key]) data[key] = [];
            data[key].push(values[i]);
            if (data[key].length > maxPoints) data[key].shift();
        }
        pointCount++;
        draw();
    }

    function draw() {
        if (!ctx || !canvas) return;
        drawGrid();
        var seriesKeys = Object.keys(data);
        for (var si = 0; si < seriesKeys.length; si++) {
            var key = seriesKeys[si];
            var pts = data[key];
            if (pts.length < 2) continue;
            ctx.strokeStyle = colors[si % colors.length];
            ctx.lineWidth = 2;
            ctx.beginPath();
            for (var pi = 0; pi < pts.length; pi++) {
                var x = (pi / (maxPoints - 1)) * canvas.width;
                var normalizedY = (pts[pi] - minY) / (maxY - minY);
                var y = canvas.height - (normalizedY * canvas.height);
                if (pi === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }
        var legend = document.getElementById('plotterLegend');
        if (legend) {
            var html = '';
            for (var li = 0; li < seriesKeys.length; li++) {
                html += '<span style="color:' + colors[li % colors.length] + ';margin-right:12px;font-size:11px">Series ' + (li + 1) + ': ' + data[seriesKeys[li]][data[seriesKeys[li]].length - 1].toFixed(1) + '</span>';
            }
            legend.innerHTML = html;
        }
    }

    function clear() {
        data = {};
        pointCount = 0;
        drawGrid();
        var legend = document.getElementById('plotterLegend');
        if (legend) legend.innerHTML = '';
    }

    function setRange(min, max) {
        minY = min;
        maxY = max;
        draw();
    }

    function start() { running = true; }
    function stop() { running = false; }
    function isRunning() { return running; }

    return { init: init, resize: resize, parseSerialData: parseSerialData, addData: addData, clear: clear, setRange: setRange, start: start, stop: stop, isRunning: isRunning, drawGrid: drawGrid };
})();

/* ===================== FILE HISTORY ===================== */
var FileHistory = (function() {
    var history = {};
    var maxVersions = 20;

    function init() {
        try {
            var saved = localStorage.getItem('tb_file_history');
            if (saved) history = JSON.parse(saved);
        } catch(e) { history = {}; }
    }

    function save() {
        localStorage.setItem('tb_file_history', JSON.stringify(history));
    }

    function createVersion(filePath, content) {
        if (!history[filePath]) history[filePath] = [];
        history[filePath].push({
            content: content,
            timestamp: new Date().toISOString(),
            size: content.length,
            lines: content.split('\n').length
        });
        if (history[filePath].length > maxVersions) {
            history[filePath] = history[filePath].slice(-maxVersions);
        }
        save();
    }

    function getVersions(filePath) {
        return history[filePath] || [];
    }

    function getVersion(filePath, index) {
        if (history[filePath] && history[filePath][index]) {
            return history[filePath][index];
        }
        return null;
    }

    function restoreVersion(filePath, index) {
        var version = getVersion(filePath, index);
        if (version && typeof editor !== 'undefined' && editor) {
            editor.setValue(version.content, -1);
            Terminal.log('Restored version from ' + new Date(version.timestamp).toLocaleString(), 'success');
        }
    }

    function deleteVersion(filePath, index) {
        if (history[filePath]) {
            history[filePath].splice(index, 1);
            save();
        }
    }

    function clearHistory(filePath) {
        if (filePath) {
            delete history[filePath];
        } else {
            history = {};
        }
        save();
    }

    function getHistorySize() {
        var total = 0;
        for (var key in history) {
            total += history[key].length;
        }
        return total;
    }

    function showHistory(filePath) {
        var versions = getVersions(filePath);
        if (versions.length === 0) {
            Terminal.log('No history for ' + filePath, 'info');
            return;
        }
        var html = '<div class="history-list">';
        for (var i = versions.length - 1; i >= 0; i--) {
            var v = versions[i];
            var d = new Date(v.timestamp);
            html += '<div class="history-item">';
            html += '<div class="history-info"><span class="history-time">' + d.toLocaleString() + '</span>';
            html += '<span class="history-size">' + v.size + ' bytes, ' + v.lines + ' lines</span></div>';
            html += '<div class="history-actions"><button class="btn btn-sm btn-ghost" onclick="FileHistory.restoreVersion(\'' + filePath + '\',' + i + ')">Restore</button>';
            html += '<button class="btn btn-sm btn-ghost" onclick="FileHistory.deleteVersion(\'' + filePath + '\',' + i + ');FileHistory.showHistory(\'' + filePath + '\')">Delete</button></div>';
            html += '</div>';
        }
        html += '</div>';
        document.getElementById('modalTitle').textContent = 'File History: ' + filePath;
        document.getElementById('modalBody').innerHTML = html;
        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-danger btn-sm" onclick="FileHistory.clearHistory(\'' + filePath + '\');IDE.closeModal()">Clear All</button><button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';
        document.getElementById('modalOverlay').classList.add('visible');
    }

    return { init: init, createVersion: createVersion, getVersions: getVersions, getVersion: getVersion, restoreVersion: restoreVersion, deleteVersion: deleteVersion, clearHistory: clearHistory, getHistorySize: getHistorySize, showHistory: showHistory };
})();

/* ===================== TERMINAL COMMANDS ===================== */
var TerminalCommands = (function() {
    var commandHistory = [];
    var historyIndex = -1;

    var commands = {
        'help': function() {
            Terminal.log('Available commands:', 'system');
            Terminal.log('  help              - Show this help', 'info');
            Terminal.log('  clear             - Clear terminal', 'info');
            Terminal.log('  ls                - List project files', 'info');
            Terminal.log('  cat <file>        - Show file content', 'info');
            Terminal.log('  wc <file>         - Word/line count', 'info');
            Terminal.log('  stats             - Project statistics', 'info');
            Terminal.log('  boards            - List available boards', 'info');
            Terminal.log('  board <id>        - Select board', 'info');
            Terminal.log('  compile           - Compile project', 'info');
            Terminal.log('  todos             - List TODOs', 'info');
            Terminal.log('  todo <text>       - Add TODO', 'info');
            Terminal.log('  theme <dark|light> - Change theme', 'info');
            Terminal.log('  echo <text>       - Print text', 'info');
            Terminal.log('  date              - Show current date', 'info');
            Terminal.log('  version           - Show IDE version', 'info');
        },
        'clear': function() { Terminal.clear(); },
        'ls': function() {
            if (!IDE.currentProject) { Terminal.log('No project loaded', 'warning'); return; }
            var files = IDE.currentProject.files || [];
            Terminal.log('Files in project:', 'system');
            for (var i = 0; i < files.length; i++) {
                var f = files[i];
                var size = f.content ? f.content.length : 0;
                var type = f.type === 'folder' ? 'DIR' : (size + 'B').padStart(6);
                Terminal.log('  ' + type + '  ' + f.path, 'info');
            }
            Terminal.log('Total: ' + files.length + ' entries', 'system');
        },
        'cat': function(args) {
            if (!args[0]) { Terminal.log('Usage: cat <file>', 'error'); return; }
            if (!IDE.currentProject) { Terminal.log('No project loaded', 'warning'); return; }
            var files = IDE.currentProject.files || [];
            for (var i = 0; i < files.length; i++) {
                if (files[i].path === args[0]) {
                    var lines = files[i].content.split('\n');
                    for (var li = 0; li < lines.length; li++) {
                        Terminal.log((li + 1).toString().padStart(4) + ' | ' + lines[li], 'info');
                    }
                    return;
                }
            }
            Terminal.log('File not found: ' + args[0], 'error');
        },
        'wc': function(args) {
            if (!args[0]) { Terminal.log('Usage: wc <file>', 'error'); return; }
            if (!IDE.currentProject) { Terminal.log('No project loaded', 'warning'); return; }
            var files = IDE.currentProject.files || [];
            for (var i = 0; i < files.length; i++) {
                if (files[i].path === args[0]) {
                    var content = files[i].content;
                    var lines = content.split('\n').length;
                    var words = content.split(/\s+/).filter(function(w) { return w; }).length;
                    var chars = content.length;
                    Terminal.log('  ' + lines + ' lines, ' + words + ' words, ' + chars + ' chars - ' + args[0], 'info');
                    return;
                }
            }
            Terminal.log('File not found: ' + args[0], 'error');
        },
        'stats': function() { Output.updateStats(); Terminal.log('Project statistics updated', 'success'); },
        'boards': function() {
            var all = BoardManager.getAllBoards();
            Terminal.log('Available boards (' + all.length + '):', 'system');
            for (var i = 0; i < Math.min(all.length, 20); i++) {
                var b = all[i];
                Terminal.log('  ' + b.id.padEnd(20) + b.name + ' (' + b.family + ')', 'info');
            }
            if (all.length > 20) Terminal.log('  ... and ' + (all.length - 20) + ' more', 'info');
        },
        'board': function(args) {
            if (!args[0]) { Terminal.log('Usage: board <id>', 'error'); return; }
            BoardManager.selectBoard(args[0]);
        },
        'compile': function() { Compiler.compile(); },
        'todos': function() {
            var todos = JSON.parse(localStorage.getItem('tb_todos') || '[]');
            if (todos.length === 0) { Terminal.log('No TODOs', 'info'); return; }
            Terminal.log('TODOs (' + todos.length + '):', 'system');
            for (var i = 0; i < todos.length; i++) {
                var t = todos[i];
                var status = t.done ? '[x]' : '[ ]';
                Terminal.log('  ' + status + ' [' + t.priority + '] ' + t.text, t.done ? 'info' : 'warning');
            }
        },
        'todo': function(args) {
            if (!args.length) { Terminal.log('Usage: todo <text>', 'error'); return; }
            var text = args.join(' ');
            var todos = JSON.parse(localStorage.getItem('tb_todos') || '[]');
            todos.push({ id: 't_' + Date.now(), text: text, priority: 'medium', done: false, created: new Date().toISOString() });
            localStorage.setItem('tb_todos', JSON.stringify(todos));
            Terminal.log('Added TODO: ' + text, 'success');
            TODO.render();
        },
        'theme': function(args) {
            if (args[0] === 'dark' || args[0] === 'light') {
                IDE.setTheme(args[0]);
            } else {
                Terminal.log('Usage: theme <dark|light>', 'error');
            }
        },
        'echo': function(args) { Terminal.log(args.join(' '), 'info'); },
        'date': function() { Terminal.log(new Date().toLocaleString(), 'info'); },
        'version': function() { Terminal.log('TinyBin IDE v3.0.0 — Production Build', 'system'); },
    };

    function execute(input) {
        input = input.trim();
        if (!input) return;
        commandHistory.unshift(input);
        if (commandHistory.length > 50) commandHistory.pop();
        historyIndex = -1;
        Terminal.log('$ ' + input, 'system');
        var parts = input.split(/\s+/);
        var cmd = parts[0].toLowerCase();
        var args = parts.slice(1);
        if (commands[cmd]) {
            commands[cmd](args);
        } else {
            Terminal.log('Unknown command: ' + cmd + '. Type "help" for available commands.', 'error');
        }
    }

    function getHistory() { return commandHistory; }
    function getPrevious() { if (historyIndex < commandHistory.length - 1) { historyIndex++; return commandHistory[historyIndex]; } return null; }
    function getNext() { if (historyIndex > 0) { historyIndex--; return commandHistory[historyIndex]; } historyIndex = -1; return ''; }

    return { execute: execute, getHistory: getHistory, getPrevious: getPrevious, getNext: getNext };
})();

/* ===================== BOARD MANAGER PANEL ===================== */
var BoardManagerPanel = (function() {
    var currentFilter = 'all';

    function renderAll() {
        var list = document.getElementById('boardList');
        if (!list) return;
        var boards = BoardManager.getAllBoards();
        if (currentFilter === 'wifi') boards = boards.filter(function(b) { return BoardManager.getBoardInfo(b.id).wifi; });
        else if (currentFilter === 'ble') boards = boards.filter(function(b) { return BoardManager.getBoardInfo(b.id).ble; });
        else if (currentFilter === 'low_power') boards = boards.filter(function(b) { return BoardManager.getBoardInfo(b.id).low_power; });
        var html = '';
        for (var i = 0; i < boards.length; i++) {
            html += BoardManager.renderBoardCard(BoardManager.getBoardInfo(boards[i].id));
        }
        list.innerHTML = html || '<div class="todo-empty">No boards match this filter</div>';
    }

    function search(q) {
        var list = document.getElementById('boardList');
        if (!list) return;
        var boards = BoardManager.searchBoards(q);
        var html = '';
        for (var i = 0; i < boards.length; i++) {
            html += BoardManager.renderBoardCard(BoardManager.getBoardInfo(boards[i].id));
        }
        list.innerHTML = html || '<div class="todo-empty">No boards found</div>';
    }

    function filter(f) {
        currentFilter = f;
        var btns = document.querySelectorAll('.board-filter');
        for (var i = 0; i < btns.length; i++) {
            btns[i].classList.toggle('active', btns[i].getAttribute('data-filter') === f);
        }
        renderAll();
    }

    function showFavorites() {
        var favs = BoardManager.getFavorites();
        document.getElementById('modalTitle').textContent = 'Favorite Boards';
        var html = '<div class="board-list">';
        if (favs.length === 0) {
            html += '<div class="todo-empty">No favorite boards yet. Click the star on any board to add it.</div>';
        } else {
            for (var i = 0; i < favs.length; i++) {
                html += BoardManager.renderBoardCard(favs[i]);
            }
        }
        html += '</div>';
        document.getElementById('modalBody').innerHTML = html;
        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';
        document.getElementById('modalOverlay').classList.add('visible');
    }

    function showCompare() {
        document.getElementById('modalTitle').textContent = 'Compare Boards';
        var html = '<div class="form-group"><label>Board 1</label><select id="compareBoard1"></select></div>';
        html += '<div class="form-group"><label>Board 2</label><select id="compareBoard2"></select></div>';
        html += '<button class="btn btn-neon btn-sm btn-block" onclick="BoardManagerPanel.doCompare()">Compare</button>';
        html += '<div id="compareResults" style="margin-top:12px"></div>';
        document.getElementById('modalBody').innerHTML = html;
        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';
        var s1 = document.getElementById('compareBoard1'), s2 = document.getElementById('compareBoard2');
        var all = BoardManager.getAllBoards();
        for (var i = 0; i < all.length; i++) {
            var o1 = document.createElement('option'); o1.value = all[i].id; o1.textContent = all[i].name; s1.appendChild(o1);
            var o2 = document.createElement('option'); o2.value = all[i].id; o2.textContent = all[i].name; s2.appendChild(o2);
        }
        s2.selectedIndex = 1;
        document.getElementById('modalOverlay').classList.add('visible');
    }

    function doCompare() {
        var id1 = document.getElementById('compareBoard1').value;
        var id2 = document.getElementById('compareBoard2').value;
        var b1 = BoardManager.getBoardInfo(id1), b2 = BoardManager.getBoardInfo(id2);
        if (!b1 || !b2) return;
        var html = '<div class="board-detail-grid">';
        var fields = ['name', 'mcu', 'flash', 'sram', 'clock', 'cores', 'voltage', 'pins', 'wifi', 'ble', 'price'];
        for (var i = 0; i < fields.length; i++) {
            var f = fields[i];
            var v1 = b1[f] !== undefined ? b1[f] : '-';
            var v2 = b2[f] !== undefined ? b2[f] : '-';
            var diff = String(v1) !== String(v2);
            html += '<div class="detail-row' + (diff ? ' style="background:var(--yellow-glow)"' : '') + '">';
            html += '<span class="detail-label">' + f.toUpperCase() + '</span>';
            html += '<span class="detail-value" style="color:' + (diff ? 'var(--yellow)' : 'var(--text)') + '">' + v1 + '</span>';
            html += '<span class="detail-value" style="color:' + (diff ? 'var(--yellow)' : 'var(--text)') + '">' + v2 + '</span>';
            html += '</div>';
        }
        html += '</div>';
        document.getElementById('compareResults').innerHTML = html;
    }

    function showPinout(pinout) {
        document.getElementById('modalTitle').textContent = 'Pinout: ' + pinout.name;
        var html = '<div class="board-detail-grid">';
        html += '<div class="detail-row"><span class="detail-label">Total Pins</span><span class="detail-value">' + pinout.total_pins + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">GPIO</span><span class="detail-value">' + pinout.gpio.join(', ') + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Analog</span><span class="detail-value">' + pinout.analog.join(', ') + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Power</span><span class="detail-value">' + pinout.power.join(', ') + '</span></div>';
        html += '<div class="detail-row"><span class="detail-label">Comm</span><span class="detail-value">' + pinout.communication.join(', ') + '</span></div>';
        html += '</div>';
        document.getElementById('modalBody').innerHTML = html;
        document.getElementById('modalFooter').innerHTML = '<button class="btn btn-ghost" onclick="IDE.closeModal()">Close</button>';
        document.getElementById('modalOverlay').classList.add('visible');
    }

    return { renderAll: renderAll, search: search, filter: filter, showFavorites: showFavorites, showCompare: showCompare, doCompare: doCompare, showPinout: showPinout };
})();

/* ===================== TERMINAL INPUT ===================== */
var TerminalInput = (function() {
    function handleKey(e) {
        if (e.key === 'Enter') { execute(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); var prev = TerminalCommands.getPrevious(); if (prev) document.getElementById('terminalInput').value = prev; }
        else if (e.key === 'ArrowDown') { e.preventDefault(); var next = TerminalCommands.getNext(); document.getElementById('terminalInput').value = next; }
    }

    function execute(cmd) {
        var input = document.getElementById('terminalInput');
        var output = document.getElementById('terminalOutput');
        var command = cmd || input.value.trim();
        if (!command) return;
        input.value = '';
        var lines = output.innerHTML;
        lines += '<div class="log-entry system">$ ' + escapeHtml(command) + '</div>';
        output.innerHTML = lines;
        TerminalCommands.execute(command);
        var termLogs = Terminal.getLogs ? Terminal.getLogs() : [];
        var lastLogs = termLogs.slice(-5);
        for (var i = 0; i < lastLogs.length; i++) {
            lines += '<div class="log-entry ' + lastLogs[i].type + '">[' + lastLogs[i].timestamp + '] ' + escapeHtml(lastLogs[i].message) + '</div>';
        }
        output.innerHTML = lines;
        output.scrollTop = output.scrollHeight;
    }

    function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function clear() {
        var output = document.getElementById('terminalOutput');
        if (output) output.innerHTML = '';
    }

    return { handleKey: handleKey, execute: execute, clear: clear };
})();

