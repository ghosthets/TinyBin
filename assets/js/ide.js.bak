        'i2c_scanner': {
            name: 'I2C Scanner',
            description: 'Scan I2C bus for connected devices',
            board: 'esp32',
            files: [
                { path: 'src/main.cpp', content: '#include <Arduino.h>\n#include <Wire.h>\n\n#define SDA_PIN 21\n#define SCL_PIN 22\n\nvoid setup() {\n    Serial.begin(115200);\n    Wire.begin(SDA_PIN, SCL_PIN);\n    Serial.println("I2C Scanner");\n    Serial.println("SDA: GPIO" + String(SDA_PIN) + ", SCL: GPIO" + String(SCL_PIN));\n}\n\nvoid loop() {\n    byte count = 0;\n    Serial.println("Scanning...");\n    for (byte addr = 1; addr < 127; addr++) {\n        Wire.beginTransmission(addr);\n        byte error = Wire.endTransmission();\n        if (error == 0) {\n            Serial.printf("  Device found at 0x%02X", addr);\n            count++;\n            switch (addr) {\n                case 0x3C: case 0x3D: Serial.println(" - OLED Display"); break;\n                case 0x76: case 0x77: Serial.println(" - BME280/BMP280"); break;\n                case 0x68: Serial.println(" - MPU6050/RTC"); break;\n                case 0x27: case 0x3F: Serial.println(" - LCD (PCF8574)"); break;\n                case 0x40: case 0x41: Serial.println(" - SHT31"); break;\n                case 0x53: Serial.println(" - ADXL345"); break;\n                default: Serial.println(" - Unknown device"); break;\n            }\n        }\n    }\n    if (count == 0) Serial.println("  No devices found");\n    else Serial.println(String(count) + " device(s) found");\n    Serial.println("---");\n    delay(5000);\n}\n\nvoid loop() {}\n', type: 'cpp' },
                { path: 'project.tbin', content: '# I2C Scanner\n\nproject_name: i2c_scanner\nversion: 1.0.0\nboard: esp32\nbinary_path: build/i2c_scanner.bin\n\nbuild:\n  optimization: -Os\n  debug: false\n', type: 'tbin' }
